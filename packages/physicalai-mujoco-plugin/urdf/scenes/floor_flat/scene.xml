<?xml version="1.0"?>
<!-- A flat floor for one floating-base robot (humanoid, quadruped). The plugin spawns the robot at
     <frame name="robot_spawn"/>, at the height of its home keyframe, and holds its base there until
     the first action. The options are the ones MuJoCo Menagerie's legged models assume (SCN-3). -->
<mujoco model="floor_flat">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" integrator="implicitfast" cone="elliptic" impratio="100"/>
  <include file="../scene_common.xml"/>
  <worldbody>
    <light pos="1 1 3.5" dir="-0.227 -0.268 -0.936" directional="false" cutoff="35" exponent="1" diffuse="0.5 0.5 0.5"/>
    <light pos="0 0 3.5" dir="0 0 -1" directional="true" diffuse="0.5 0.5 0.5" castshadow="false"/>
    <geom name="floor" type="plane" size="0 0 0.05" material="floor" condim="3"/>
    <frame name="robot_spawn"/>
    <!-- Behind the robot, looking 20 degrees down; composing the scene makes it follow the robot. -->
    <camera name="chase" pos="-2.5 0 1.2" xyaxes="0 -1 0 0.342 0 0.94" fovy="45"/>
    <camera name="overview" mode="fixed" pos="2.5 -2.5 1.5" xyaxes="0.707 0.707 0 -0.192 0.192 0.962" fovy="45"/>
  </worldbody>
</mujoco>
