{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "draft-pull-request": true,
  "separate-pull-requests": true,
  "include-v-in-tag": true,
  "include-component-in-tag": true,
  "changelog-sections": [
    { "type": "feat", "section": "✨ Features", "hidden": false },
    { "type": "fix", "section": "🐛 Bug Fixes", "hidden": false },
    {
      "type": "perf",
      "section": "🚀 Performance Improvements",
      "hidden": false
    },
    { "type": "refactor", "section": "♻️ Code Refactoring", "hidden": false },
    { "type": "docs", "section": "📚 Documentation", "hidden": false },
    { "type": "test", "section": "✅ Tests", "hidden": false },
    { "type": "ci", "section": "👷 CI/CD", "hidden": false },
    { "type": "chore", "section": "🔧 Chores", "hidden": false },
    { "type": "revert", "section": "⏪ Reverts", "hidden": false }
  ],
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "physicalai",
      "changelog-path": "CHANGELOG.md",
      "exclude-paths": ["packages/*"],
      "include-component-in-tag": false
    },
    "packages/physicalai-studio-plugin": {
      "release-type": "python",
      "package-name": "physicalai-studio-plugin",
      "changelog-path": "CHANGELOG.md"
    },
    "packages/physicalai-bimanual-so101-plugin": {
      "release-type": "python",
      "package-name": "physicalai-bimanual-so101-plugin",
      "changelog-path": "CHANGELOG.md"
    },
    "packages/physicalai-rebot-b601-plugin": {
      "release-type": "python",
      "package-name": "physicalai-rebot-b601-plugin",
      "changelog-path": "CHANGELOG.md"
    },
    "packages/physicalai-lerobot-plugin": {
      "release-type": "python",
      "package-name": "physicalai-lerobot-plugin",
      "changelog-path": "CHANGELOG.md"
    },
    "packages/physicalai-stararm-plugin": {
      "release-type": "python",
      "package-name": "physicalai-stararm-plugin",
      "changelog-path": "CHANGELOG.md"
    }
  }
}
