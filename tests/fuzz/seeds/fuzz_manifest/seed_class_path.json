{
  "format": "policy_package",
  "version": "1.0",
  "policy": { "name": "smolvla" },
  "model": {
    "n_obs_steps": 1,
    "runner": {
      "class_path": "physicalai.inference.runners.SinglePass",
      "init_args": {}
    },
    "preprocessors": [
      {
        "class_path": "physicalai.inference.preprocessors.StatsNormalizer",
        "init_args": {
          "mode": "mean_std",
          "features": ["observation.state"],
          "stats_path": "stats.safetensors"
        }
      },
      {
        "class_path": "physicalai.inference.preprocessors.ResizeSmolVLA",
        "init_args": { "image_resolution": [512, 512], "image_layout": "BCHW" }
      },
      {
        "class_path": "physicalai.inference.preprocessors.HFTokenizer",
        "init_args": { "artifact": "tokenizer" }
      }
    ],
    "postprocessors": [
      {
        "class_path": "physicalai.inference.postprocessors.ActionChunkTrimmer",
        "init_args": { "n_action_steps": 10 }
      },
      {
        "class_path": "physicalai.inference.postprocessors.StatsDenormalizer",
        "init_args": {
          "mode": "mean_std",
          "features": ["action"],
          "stats_path": "stats.safetensors"
        }
      }
    ]
  }
}
