{
  "format": "policy_package",
  "version": "1.0",
  "policy": {
    "name": "act",
    "source": {
      "repo_id": "lerobot/act_aloha_sim_transfer_cube_human",
      "class_path": "physicalai.policies.act.policy.ACT"
    }
  },
  "model": {
    "n_obs_steps": 1,
    "runner": { "type": "single_pass" },
    "artifacts": { "model": "model.onnx" },
    "preprocessors": [
      {
        "type": "normalize",
        "mode": "mean_std",
        "artifact": "stats.safetensors",
        "features": ["observation.state", "observation.images.top"]
      },
      {
        "type": "resize",
        "image_layout": "BCHW",
        "image_resolution": [224, 224],
        "mode": "letterbox"
      }
    ],
    "postprocessors": [
      {
        "type": "denormalize",
        "mode": "mean_std",
        "artifact": "stats.safetensors",
        "features": ["action"]
      }
    ]
  },
  "hardware": {
    "robots": [
      {
        "name": "main",
        "type": "Koch v1.1",
        "state": {
          "shape": [6],
          "dtype": "float32",
          "order": [
            "shoulder_pan",
            "shoulder_lift",
            "elbow_flex",
            "wrist_flex",
            "wrist_roll",
            "gripper"
          ]
        },
        "action": {
          "shape": [6],
          "dtype": "float32",
          "order": [
            "shoulder_pan",
            "shoulder_lift",
            "elbow_flex",
            "wrist_flex",
            "wrist_roll",
            "gripper"
          ]
        }
      }
    ],
    "cameras": [{ "name": "top", "shape": [3, 480, 640], "dtype": "uint8" }]
  },
  "metadata": {
    "created_at": "2026-01-01T00:00:00Z",
    "created_by": "lerobot"
  }
}
